# Requests CiA402 homing of one or more drives. The exact procedure is defined by the
# serving node (e.g. an in-cycle controlword pulse for drives already in Homing mode,
# or a full SDO sequence with the cyclic exchange stopped). Suited to instantaneous
# homing methods only (e.g. homing at the current position); the drive must be
# commissioned accordingly.

# DoF names to home. Empty = every configured drive.
string[] dof_names
---
bool success
# Per-drive result details.
string return_message
