# End the latched drive fault reaction on the named joints (empty = all configured joints).
# Clearing neither resets a drive's fault nor enables it: request reset_fault and enable
# afterwards. The hardware forwards setpoints to a drive again only from its enable on.
string[] dof_names
---
# Whether the request was accepted. False if a named joint is not configured.
bool success

# Human-readable result or error description.
string message
