# Walk one or more CiA 402 drives' state machine to Operation Enabled
# (Switch On Disabled, Ready to Switch On, Switched On, Operation Enabled).
# Each named drive moves independently, and other drives on the bus are not affected.
# A drive in Fault is not reset: clear the fault first with the reset_fault drive action.

# DoF names to engage. Empty = every configured drive.
string[] dof_names
---
# Return message
string return_message
