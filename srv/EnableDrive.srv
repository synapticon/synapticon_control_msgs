# This service walks a single CiA402 drive's state machine to Operation Enabled
# (Switch On Disabled -> Ready to Switch On -> Switched On -> Operation Enabled,
# resetting a Fault along the way if needed), driven per-cycle from the hardware
# interface for that drive only -- it does not touch any other drive on the bus.

# DoF name
string dof_name
---
# Return message
string return_message
